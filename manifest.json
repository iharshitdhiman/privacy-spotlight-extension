{
  "manifest_version": 3,
  "name": "Privacy Spotlight",
  "version": "1.0.0",
  "description": "Blur your screen and keep only a soft spotlight around the cursor, so shoulder-surfers can't read it.",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Privacy Spotlight",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "toggle-blur": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Toggle Privacy Spotlight"
    }
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true },
    { "matches": ["https://extensionpay.com/*"], "js": ["ExtPay.js"], "run_at": "document_start" }
  ]
}
